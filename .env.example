NODE_ENV=development
PORT=4000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=traitedu
DATABASE_USER=traitedu_app
DATABASE_PASSWORD=Trait@1234

DATABASE_URL=postgresql://traitedu_app:replace-me@localhost:5432/traitedu
DATABASE_POOL_MAX=10

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production database connection. Prefer DATABASE_URL from Supabase Database settings.
# Do not use SUPABASE_SERVICE_ROLE_KEY as the PostgreSQL password.
# DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
# SUPABASE_DB_PASSWORD=your-db-password

SESSION_SECRET=replace-with-a-long-random-value
SEED_SUPERADMIN_PASSWORD=replace-before-production
SEED_BRANCH_ADMIN_PASSWORD=replace-before-production
SEED_STUDENT_PASSWORD=replace-before-production
SEED_TEACHER_PASSWORD=replace-before-production
